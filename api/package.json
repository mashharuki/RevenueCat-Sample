{
  "name": "memo-app-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types src/types/env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply memo-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply memo-app-db --remote"
  },
  "dependencies": {
    "hono": "4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
