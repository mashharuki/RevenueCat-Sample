{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memo-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Free-tier memo count limit before RevenueCat entitlement check kicks in (design.md Requirement 3.1/3.4)
    "FREE_TIER_MEMO_LIMIT": 20,
    // RevenueCat entitlement identifier that unlocks unlimited memos (see .kiro/specs/memo-app/tasks.md Implementation Notes)
    "RC_ENTITLEMENT_ID": "memo_premium",
    // Firebase project ID (see .kiro/specs/memo-app/tasks.md 1.2 Implementation Notes). Used to
    // validate the `iss`/`aud` claims of Firebase ID tokens in FirebaseAuthMiddleware.
    "FIREBASE_PROJECT_ID": "memo-app-shipaton"
  },
  "d1_databases": [
    {
      "binding": "memo_app_db",
      "database_name": "memo-app-db",
      "database_id": "0576b63c-283b-4e5b-9ec1-b9dd2fec4bb3",
      "migrations_dir": "./migrations"
    }
  ]
}
